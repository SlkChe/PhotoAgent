@startuml "PhotoAgent C4-Container"
!include <C4/C4_Container>
title PhotoAgent MVP-1 — C4 Container (A-02 утверждена)
Person(reader, "Фотограф / читатель", "Закрытая группа до 30; одновременно 2–3; TTL 12 часов бездействия")
System_Boundary(photoagent, "PhotoAgent MVP-1") {
  Container(entry, "Ingress-прокси", "HTTPS / ingress", "Единый origin UI и браузерных маршрутов сессии; доступ через существующую приватную сеть")
  Container(ui, "streamlit-ui", "Python 3.14 / Streamlit", "Ввод, временная копия истории из API, восстановление после refresh, статусы, источники, очистка и оценка")
  Container(api, "core-api", "Python 3.14 / FastAPI; один процесс", "Локальные анализ и планирование, поиск, Evidence, генерация и проверка; сессии и задания в RAM, потеря при перезапуске")
  Container(inference, "Local inference", "Локальный процесс; runtime и модель TBD", "Локальный разбор и помощь планировщику; без облачного резерва; одна загрузка модели, ограниченная очередь")
  ContainerDb(stats, "Общая статистика", "Дневные JSON-файлы / постоянный локальный том", "Агрегаты ошибок и откликов за 30 дней; без переписки и ID сессий/запросов")
}
System_Ext(search, "Поисковые MCP-серверы", "Поиск и разрешённое чтение материалов")
System_Ext(wiki, "Wiki-справочники", "Энциклопедические сведения и сущности")
System_Ext(llm, "Облачный генератор ответа", "Один провайдер/агрегатор и одна модель на развёртывание; смена конфигурацией")
Rel(reader, entry, "Общается; восстанавливает сессию после refresh по cookie", "HTTPS / WebSocket")
Rel(entry, ui, "Маршрутизирует интерфейс и подключение с cookie", "HTTP / WebSocket, внутренняя сеть")
Rel(entry, api, "Маршрутизирует только браузерные операции сессии", "HTTP, внутренняя сеть")
Rel(ui, api, "Управляет сессией, отправляет сообщения, опрашивает выполнения", "HTTP / JSON, внутренняя сеть")
Rel(api, inference, "Передаёт ограниченный контекст, получает структурированный результат", "Локальный HTTP / JSON (предложение)")
Rel(api, search, "Вызывает зарегистрированные инструменты", "MCP / HTTPS")
Rel(api, wiki, "Ищет и получает записи", "HTTPS API")
Rel(api, llm, "Передаёт Evidence и требования, получает черновик Answer", "HTTPS API")
Rel(api, stats, "Записывает снимки, читает статистику, удаляет устаревшие периоды", "Локальный файловый ввод-вывод; один писатель")
SHOW_LEGEND()
@enduml
