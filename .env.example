# Только несекретные примеры. Приложение читает окружение; файл автоматически не загружается.
# Адрес API для Python-процесса Streamlit и отдельно для браузерного сигнала закрытия.
PHOTO_UI_BACKEND_URL=http://127.0.0.1:8000
PHOTO_UI_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
PHOTO_UI_REQUEST_TIMEOUT_SECONDS=10
PHOTO_UI_HEARTBEAT_SECONDS=20

# Время жизни контекста без heartbeat. Это очистка сессий, не кеширование.
PHOTO_API_SESSION_TTL_SECONDS=180
PHOTO_API_CLEANUP_INTERVAL_SECONDS=10
PHOTO_API_MAX_SESSIONS=1000
PHOTO_API_MAX_TURNS=100

# Лимиты облачной LLM, вход + выход. Контроль расходов реализуется в B-14.
PHOTO_API_LLM_PROJECT_TOKENS_PER_24H=100000
PHOTO_API_LLM_PROJECT_TOKENS_PER_MINUTE=5000
PHOTO_API_LLM_PROJECT_TOKENS_PER_REQUEST=5000
PHOTO_API_LLM_SESSION_MAX_REQUESTS=100
PHOTO_API_LLM_SESSION_TOKENS_PER_REQUEST=1500
PHOTO_API_LLM_SESSION_TOKENS_PER_MINUTE=3000
PHOTO_API_LLM_ESTIMATED_CHARS_PER_TOKEN=3

# Порты публикации контейнеров на локальном компьютере.
BACKEND_PORT=8000
FRONTEND_PORT=8501
